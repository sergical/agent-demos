# OpenRouter API key — every model call (lead agent and both subagents) routes through OpenRouter.
OPENROUTER_API_KEY=

# "true" posts the review as a PR comment via the GitHub API; unset/false writes review.md to disk instead.
POST_TO_GITHUB=false

# Token with pull-request write access. GitHub Actions injects its own GITHUB_TOKEN — only set this locally.
GITHUB_TOKEN=

# owner/repo of the pull request, e.g. your-org/your-repo (set automatically inside GitHub Actions).
GITHUB_REPOSITORY=

# Number of the pull request to comment on.
PR_NUMBER=
